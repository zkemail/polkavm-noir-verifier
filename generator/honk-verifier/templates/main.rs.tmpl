//! PolkaVM contract entry point: circuit-specific, generated per build.
//!
//! `do_verify()`'s orchestration (load VK, load proof, generate transcript,
//! compute public input delta, verify sumcheck, verify shplemini) is a direct
//! translation of HonkVerifier.sol's `BaseHonkVerifier.verify()`.
//! Source: `bb write_solidity_verifier` output (Aztec/Barretenberg).
#![no_main]
#![no_std]
extern crate alloc;

mod honk;
mod sumcheck;
mod vk;

use alloc::vec::Vec;
use pallet_revive_uapi::{HostFn, HostFnImpl as api, ReturnFlags};
use polkavm_derive::polkavm_export;

use honk::fr::Fr;
use honk::proof::load_proof;
use honk::transcript::generate_transcript;
use vk::load_vk;

#[global_allocator]
static ALLOC: simplealloc::SimpleAlloc<{ {{HEAP_KB}} * 1024 }> = simplealloc::SimpleAlloc::new();
// {{HEAP_KB}}KB heap for {{NUM_PUB}} public inputs (bump allocator — no free during verify)

/// Function selector for verify(bytes,bytes32[]) = 0xea50d0e4
const VERIFY_SELECTOR: [u8; 4] = [0xea, 0x50, 0xd0, 0xe4];

const LOG_N: usize = {{LOG_N}};

#[panic_handler]
fn panic(_info: &core::panic::PanicInfo) -> ! {
    unsafe {
        core::arch::asm!("unimp");
        core::hint::unreachable_unchecked();
    }
}

#[no_mangle]
#[polkavm_export]
pub extern "C" fn deploy() {}

#[no_mangle]
#[polkavm_export]
pub extern "C" fn call() {
    let length = api::call_data_size() as usize;
    if length < 4 {
        api::return_value(ReturnFlags::REVERT, b"INPUT_TOO_SHORT");
    }

    let mut selector = [0u8; 4];
    api::call_data_copy(&mut selector, 0);

    match selector {
        VERIFY_SELECTOR => handle_verify(length),
        _ => api::return_value(ReturnFlags::REVERT, b"UNKNOWN_FUNCTION"),
    }
}

/// Read a uint256 from 32 bytes big-endian as a usize.
fn read_u256_as_usize(bytes: &[u8]) -> Option<usize> {
    for b in bytes[0..24].iter() {
        if *b != 0 {
            return None;
        }
    }
    let mut val = [0u8; 8];
    val.copy_from_slice(&bytes[24..32]);
    Some(u64::from_be_bytes(val) as usize)
}

/// Outcome of parsing the `verify(bytes,bytes32[])` calldata.
enum ParseResult {
    /// Decoded successfully and the public-inputs array has the expected length.
    Ok((Vec<u8>, Vec<[u8; 32]>)),
    /// ABI decoded, but the public-inputs array length doesn't match NUMBER_OF_PUBLIC_INPUTS.
    /// Mapped to REVM's `PublicInputsLengthWrong()` by the caller.
    PublicInputsLenWrong,
}

/// Manual ABI decode of verify(bytes proof, bytes32[] publicInputs).
/// Returns `None` for any other ABI shape failure (mapped to generic revert).
fn parse_verify_args(data: &[u8]) -> Option<ParseResult> {
    if data.len() < 64 {
        return None;
    }
    let bytes_offset = read_u256_as_usize(&data[0..32])?;
    let arr_offset = read_u256_as_usize(&data[32..64])?;

    if data.len() < bytes_offset.checked_add(32)? {
        return None;
    }
    let bytes_len = read_u256_as_usize(&data[bytes_offset..bytes_offset + 32])?;
    let proof_start = bytes_offset.checked_add(32)?;
    let proof_end = proof_start.checked_add(bytes_len)?;
    if data.len() < proof_end {
        return None;
    }
    let proof_bytes = data[proof_start..proof_end].to_vec();

    if data.len() < arr_offset.checked_add(32)? {
        return None;
    }
    let arr_len = read_u256_as_usize(&data[arr_offset..arr_offset + 32])?;
    let arr_data_start = arr_offset.checked_add(32)?;
    let arr_data_end = arr_data_start.checked_add(arr_len.checked_mul(32)?)?;
    if data.len() < arr_data_end {
        return None;
    }
    if arr_len != {{NUM_PUB}} {
        return Some(ParseResult::PublicInputsLenWrong);
    }
{{PUB_INPUT_PARSING}}

    Some(ParseResult::Ok((proof_bytes, public_inputs)))
}

/// UltraHonk proof size in bytes for the current protocol (bb v0.84.0,
/// CONST_PROOF_SIZE_LOG_N = 28, NUMBER_OF_ENTITIES = 40).
/// 8 G1·128 + 28·8·Fr·32 + 40·Fr·32 + 27 G1·128 + 28·Fr·32 + 2 G1·128 = 14080.
const PROOF_SIZE: usize = 14080;

/// Verifier return-data protocol (matches REVM-built HonkVerifier.sol's
/// revert behaviour on failure; success is a single 0x01 byte rather than
/// the strict-Solidity 32-byte `bool true` ABI because pallet-revive's
/// EVM-RPC adapter currently flags multi-byte returns as `status=0`
/// (reverted) in transaction receipts even when the contract executed
/// successfully — see notes in FINDINGS. Clients should decode the return
/// as `bytes1` (`0x01` = success) and rely on the custom-error selector
/// in revert data for failure cases.
const RETURN_TRUE_BYTE: [u8; 1] = [1];

/// keccak256("ProofLengthWrong()")[:4] — matches HonkVerifier.sol
const ERR_PROOF_LENGTH_WRONG: [u8; 4] = [0xed, 0x74, 0xac, 0x0a];
/// keccak256("PublicInputsLengthWrong()")[:4]
const ERR_PUBLIC_INPUTS_LENGTH_WRONG: [u8; 4] = [0xfa, 0x06, 0x65, 0x93];
/// keccak256("SumcheckFailed()")[:4]
const ERR_SUMCHECK_FAILED: [u8; 4] = [0x9f, 0xc3, 0xa2, 0x18];
/// keccak256("ShpleminiFailed()")[:4]
const ERR_SHPLEMINI_FAILED: [u8; 4] = [0xa5, 0xd8, 0x2e, 0x8a];

/// Internal verifier result code (kept for granular logging, mapped to a
/// Solidity custom error at the contract boundary):
///   0     = success
///   100+i = sumcheck round i check_sum mismatch → SumcheckFailed
///   200   = grand-Honk relation sum mismatch    → SumcheckFailed
///   50    = shplemini / KZG pairing failed      → ShpleminiFailed
const RC_SUCCESS: u8 = 0;
const RC_SHPLEMINI_FAILED: u8 = 50;

fn handle_verify(length: usize) {
    let data_len = length.saturating_sub(4);
    let mut data = alloc::vec![0u8; data_len];
    if data_len > 0 {
        api::call_data_copy(&mut data, 4);
    }

    let (proof_bytes, public_inputs) = match parse_verify_args(&data) {
        Some(ParseResult::Ok(x)) => x,
        Some(ParseResult::PublicInputsLenWrong) => {
            api::return_value(ReturnFlags::REVERT, &ERR_PUBLIC_INPUTS_LENGTH_WRONG);
        }
        None => {
            api::return_value(ReturnFlags::REVERT, b"ABI_DECODE_FAILED");
        }
    };

    if proof_bytes.len() != PROOF_SIZE {
        api::return_value(ReturnFlags::REVERT, &ERR_PROOF_LENGTH_WRONG);
    }

    let code = do_verify(&proof_bytes, &public_inputs);
    match code {
        RC_SUCCESS => api::return_value(ReturnFlags::empty(), &RETURN_TRUE_BYTE),
        RC_SHPLEMINI_FAILED => {
            api::return_value(ReturnFlags::REVERT, &ERR_SHPLEMINI_FAILED);
        }
        _ => {
            // 100+i sumcheck round, or 200 grand-Honk: both map to SumcheckFailed()
            api::return_value(ReturnFlags::REVERT, &ERR_SUMCHECK_FAILED);
        }
    }
}

fn do_verify(proof_bytes: &[u8], public_inputs: &[[u8; 32]]) -> u8 {
    let vk = load_vk();
    let proof = load_proof(proof_bytes);

    let t = generate_transcript(
        &proof,
        public_inputs,
        vk.circuit_size,
        vk.public_inputs_size,
        vk.pub_inputs_offset,
    );

    let mut t = t;
    t.relation_parameters.public_inputs_delta = compute_public_input_delta(
        public_inputs,
        t.relation_parameters.beta,
        t.relation_parameters.gamma,
        vk.pub_inputs_offset,
        vk.circuit_size,
        vk.public_inputs_size,
    );

    let sumcheck_code = sumcheck::verify_sumcheck_diag(&proof, &t, LOG_N);
    if sumcheck_code != 0 {
        return sumcheck_code;
    }

    if !honk::shplemini::verify_shplemini(&proof, &vk, &t) {
        return RC_SHPLEMINI_FAILED;
    }

    RC_SUCCESS
}

fn compute_public_input_delta(
    public_inputs: &[[u8; 32]],
    beta: Fr,
    gamma: Fr,
    offset: u64,
    n: u64,
    _num_public_inputs: u64,
) -> Fr {
    let mut numerator = Fr::one();
    let mut denominator = Fr::one();

    let mut numerator_acc = gamma + beta * Fr::from_u64(n + offset);
    let mut denominator_acc = gamma - beta * Fr::from_u64(offset + 1);

    for pi in public_inputs.iter() {
        let pub_input = Fr::from_be_bytes(pi);
        numerator = numerator * (numerator_acc + pub_input);
        denominator = denominator * (denominator_acc + pub_input);
        numerator_acc = numerator_acc + beta;
        denominator_acc = denominator_acc - beta;
    }

    numerator * denominator.inverse().unwrap()
}
